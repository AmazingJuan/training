# Where contact submissions are forwarded (Make, Zapier, Formspree…).
NUXT_CONTACT_WEBHOOK=

# Staff tools listed on /intranet (full URLs, read at build time).
# A module without a URL is shown as "pending" instead of linking nowhere.
NUXT_PUBLIC_INTRANET_LICITDATA=
NUXT_PUBLIC_INTRANET_COTIZADOR=
NUXT_PUBLIC_INTRANET_PRESUPUESTOS=

# Visit measurement (empty = no tracking). GA4 measurement ID and Clarity project ID.
NUXT_PUBLIC_ANALYTICS_GA_ID=
NUXT_PUBLIC_ANALYTICS_CLARITY_ID=

# Search Console / Bing Webmaster Tools HTML-tag verification (content value only).
NUXT_PUBLIC_VERIFICATION_GOOGLE=
NUXT_PUBLIC_VERIFICATION_BING=
